@page "{id}"
@model BlinkshieldAdmin.Pages.EditWardrobeItemModel
@{
    ViewData["Title"] = "Edit Wardrobe Item";
}

<div class="edit-wardrobe">
<h2>Edit Wardrobe Item</h2>

<form method="post" enctype="multipart/form-data" novalidate>
    <input type="hidden" asp-for="Item.ItemId" />

    <div class="editwardform">
        <label asp-for="Item.Name"></label>
        <input asp-for="Item.Name" class="form-control" />
        <span asp-validation-for="Item.Name" class="text-danger"></span>
    </div>

       <div class="editwardform">
        <label asp-for="Item.Type"></label>
        <select asp-for="Item.Type" class="form-control">
            <option value="">Select Type</option>
            <option value="hat">Hat</option>
            <option value="shirt">Shirt</option>
            <option value="glasses">Glasses</option>
            <option value="shoes">Shoes</option>
            <option value="accessory">Accessory</option>
        </select>
        <span asp-validation-for="Item.Type" class="text-danger"></span>
    </div>

    <div class="editwardform">
        <label asp-for="Item.Price"></label>
        <input asp-for="Item.Price" class="form-control" type="number" min="0" step="0.01" />
        <span asp-validation-for="Item.Price" class="text-danger"></span>
    </div>

        <div class="editwardform">
        <label asp-for="ImageFile" class="control-label">Image</label>
        <input type="file" asp-for="ImageFile" class="form-control" data-val="false" />
        <small class="form-text text-muted">Leave blank to keep current image</small>

        @if (Model.Item.Image != null && Model.Item.Image.Length > 0)
        {
            <div class="mt-2">
                <span class="font-weight-bold">Current Image:</span>
                <img src="data:image/png;base64,@Convert.ToBase64String(Model.Item.Image)"
                     class="img-thumbnail mt-2" style="max-height: 200px;" />
            </div>
        }
    </div>

        <div class="editwardform">
        <label asp-for="Item.Description"></label>
        <textarea asp-for="Item.Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Item.Description" class="text-danger"></span>
    </div>

        <div class="editwardform">
        <button type="submit" class="addedward">
            <i class="fas fa-save"></i> Save Changes
        </button>
        <a asp-page="/AdminWardrobe" class="cancelward">
            <i class="fas fa-times"></i> Cancel
        </a>
    </div>
</form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>a
        $(document).ready(function () {
            $("form").data("validator").settings.ignore = ":hidden, [data-val=false]";
        });
    </script>
}
